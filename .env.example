# Arquivo unico de variaveis de ambiente para todo o projeto (frontend + backend).
# Copie para .env na raiz do repositorio:  cp .env.example .env
#
# Frontend (Vite): le este arquivo via `envDir` no vite.config.ts. Apenas chaves
# com prefixo VITE_ sao expostas ao bundle do navegador.
# Backend (Spring): le este arquivo via spring-dotenv, configurado em
# api/src/main/resources/.env.properties (directory=..), entao rode a API de dentro de api/.

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Style JSON do mapa base (modo claro). Padrao: OpenFreeMap Positron, sem chave.
# Aceita qualquer style MapLibre (ex.: instancia self-hosted do OpenFreeMap).
VITE_MAP_STYLE_LIGHT_URL=https://tiles.openfreemap.org/styles/positron

# --- Backend: banco de dados ---
DB_URL=jdbc:postgresql://localhost:5432/alagou
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Backend: autenticacao ---
# Generate a fresh 512-bit (64-byte) random secret per environment, e.g.:
#   openssl rand -base64 64
# Never reuse the same JWT_SECRET across dev, staging and production.
JWT_SECRET=generate-a-unique-512-bit-secret-per-environment
JWT_EXPIRATION_MS=7200000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Backend: rede / proxy ---
# In production set this to the exact browser origin of the app (scheme + host + port), not localhost.
# Em dev, os padroes abaixo (Spring allowed-origin-patterns) liberam localhost e as faixas de IP
# privado, permitindo abrir o app pelo celular via IPv4 do WiFi (ex.: http://192.168.0.2:5173).
CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*],http://192.168.*:[*],http://10.*:[*],http://172.16.*:[*],http://172.17.*:[*],http://172.18.*:[*],http://172.19.*:[*]
# Comma-separated CIDR ranges of reverse proxies allowed to set X-Forwarded-For. Leave empty when there is no proxy.
TRUSTED_PROXIES=
# Set to true only when the app runs behind HTTPS termination (production).
REQUIRE_HTTPS=false

# --- Backend: fontes de dados oficiais ---
WORLDTIDES_API_KEY=your-worldtides-api-key

# --- Backend: RabbitMQ (push notifications) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Backend: push notifications (Web Push / VAPID) ---
PUSH_ENABLED=false
# Gere o par de chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@alagou.app
